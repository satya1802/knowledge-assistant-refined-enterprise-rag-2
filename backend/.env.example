# Copy to .env. These supplement the root .env.example.

# Google Gemini API key (server-side only, never exposed to the frontend).
GEMINI_API_KEY=

# Path to the Tesseract OCR binary. Leave empty to disable OCR; the worker
# skips scanned-PDF processing with a clear message instead of failing.
TESSERACT_CMD=

# Comma-separated list of allowed CORS origins for the frontend.
# Defaults to the Vite dev server in development.
# ALLOWED_ORIGINS=http://localhost:5173